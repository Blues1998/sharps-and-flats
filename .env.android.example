# Keys for anonymous usage and crash reports in the Android app.
# Copy to .env.android.local (git ignores *.local) and fill in. Both are
# public client keys: they ship inside the APK and can only send data, not
# read it. Leave a line out and that service stays off. The website build
# never reads this file.

# Sentry > Settings > Projects > (project) > Client Keys (DSN)
VITE_SENTRY_DSN=

# PostHog > Project settings > Project API key
VITE_POSTHOG_KEY=
# The PostHog region your project is in: https://eu.i.posthog.com or https://us.i.posthog.com
VITE_POSTHOG_HOST=https://eu.i.posthog.com
